# Core bot strings. Format: head.key=value  (%1, %2 ... are args)
# Set the active language in config.json ("language": "en").

# bot/login/login.js
login.staleSessionParams=Supplied session params are stale; retrying login without them
login.noCookie=No Instagram cookie found in account.txt or config.json
login.loginSuccess=Logged in to Instagram as %1
login.sessionInvalid=Instagram rejected the session (account suspended or cookie expired). Update account.txt with a fresh cookie and restart.
login.sessionRateLimited=Instagram is rate-limiting this account (HTTP 429). Your cookie is still valid - wait a few minutes, then restart.
login.sessionChallenge=Instagram requires a security check (challenge/checkpoint). Open the Instagram app, complete the verification, then restart the bot.
login.sessionExpired=The Instagram session cookie is expired or logged out. Paste a fresh cookie in account.txt and restart.
login.sessionSuspended=This Instagram account appears to be suspended or disabled. Log in on instagram.com to review the account status.
login.proxyEnabled=Routing Instagram traffic through proxy %1
login.transientRetry=Instagram did not answer cleanly (%1) - the cookie may still be valid. Retrying login in %2s (attempt %3 of %4).

